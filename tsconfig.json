{
    "compilerOptions": {
        "target": "es2017",
        "moduleResolution": "Node",
        "outDir": "dist/",
        "baseUrl": "./",
        "sourceMap": true,
        "allowSyntheticDefaultImports": true,
        "allowUmdGlobalAccess": true,
        "paths": {
            "@/*": [
                "./src/*"
            ]
        }
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "@types/screeps",
        "src/main.ts",
        "src/v2/**/*.ts"
    ]
}
